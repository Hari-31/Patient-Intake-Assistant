# Copy this file to .env for local development. Never commit real secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only: shared HS256 JWT signing secret.
SUPABASE_JWT_SECRET=
# Backend only: never expose this RLS-bypassing key to clients.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated browser origins allowed to call FastAPI.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
